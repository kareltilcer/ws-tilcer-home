# Frontend build-time config (Vite). Copy to .env.production (or set in Coolify).

# Base URL of the shared auth service (SPA login + /token/refresh live here).
# Required for the production build's Mode A auth.
VITE_AUTH_BASE_URL=https://auth.tilcer.cz

# Force real Mode A auth in dev (default: off in dev, on in production builds).
# Leave unset for offline dev with the dev-admin stub.
# VITE_REAL_AUTH=true

# --- Crash reporting + feedback widget (status.tilcer.cz) --------------------
# All optional. With none of them set the SPA installs no error listeners, loads
# no widget and renders no "Nahlásit problém" trigger — which is what every local
# build gets. The README's "Crash reporting and feedback" section is the contract;
# these are the names.
#
# The ingest URL and key are the SAME pair the backend holds in STATUS_INGEST_URL
# / STATUS_INGEST_KEY: status issues one ingest key per site, and baking it here
# is what makes that copy public. It is a Sentry DSN, not a secret — it can only
# POST a crash for one site into a rate-limited endpoint.
# VITE_STATUS_INGEST_URL=https://status.tilcer.cz/api/ingest/home
# VITE_STATUS_INGEST_KEY=ik_...

# The widget key (site detail → User feedback). A genuinely different key on a
# different endpoint: rotating it never touches crash reporting.
# VITE_STATUS_WIDGET_KEY=wk_...

# The site id in status. Defaults to "home".
# VITE_STATUS_SITE=home

# ⚠ Set these two only in PAIRS with the backend's STATUS_ENVIRONMENT /
# STATUS_RELEASE, or one deployment reaches the board under two names. Unset on
# both sides they already agree: the backend maps HOME_ENV onto prod/dev, which
# is what this half defaults to.
# VITE_STATUS_ENVIRONMENT=prod
# VITE_STATUS_RELEASE=home@2026.36.1

# Point the widget at something other than production (a staging status, or a
# locally served bundle). Pin a MAJOR. Unset ⇒ status.tilcer.cz/widget/v1.js
# VITE_STATUS_WIDGET_URL=https://status.tilcer.cz/widget/v1.js
